VITE_SUPABASE_URL=https://abcdxyz123.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here
# Backend API base URL (no trailing slash). Used by src/api/client.ts
# In production builds, must be https and must not use localhost (see src/config/apiEnv.ts).
VITE_API_URL='http://127.0.0.1:8000'

# After Spotify OAuth, backend should redirect the browser to this frontend URL (must match deployed origin).
# Defaults to {origin}/integrations/spotify/callback if unset.
# VITE_SPOTIFY_OAUTH_RETURN_URL=http://127.0.0.1:5173/integrations/spotify/callback

# Privacy policy metadata (optional; defaults exist in src/config/privacy.ts)
# VITE_PRIVACY_POLICY_VERSION=1.0
# VITE_PRIVACY_POLICY_EFFECTIVE_DATE=2026-03-01
# VITE_SUPPORT_EMAIL=support@example.com
# VITE_PRIVACY_EMAIL=privacy@example.com